# Copy this file to .env and fill in your real key.
# Get your key at: https://hevy.com/settings?developer
# .env is git-ignored, so your real key never gets committed.
HEVY_API_KEY=your_key_here

# Optional: where the local copy of your Hevy data is kept (default: data/hevy.db).
# It only holds what the app needs (no notes or training times) and can be deleted
# at any time; the next sync rebuilds it.
# DATABASE_PATH=data/hevy.db
